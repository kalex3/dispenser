{
  "name": "dispenser",
  "version": "1.0.2",
  "description": "A NodeJS service to generate and dispense anonymous AuthTokens to access Google Play Store",
  "main": "app.js",
  "author": "Rahul Kumar Patel",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p .",
    "release": "tsc -p . --sourceMap false",
    "clean": "rm -rf dist",
    "dispenser": "node --max-old-space-size=4096 dist/app.js",
    "compile-proto": "pbjs -t static-module -w commonjs -d -o ./src/google_play.js ./google_play.proto"
  },
  "keywords": [
    "Aurora",
    "Dispenser",
    "AuthToken"
  ],
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26",
    "protobufjs-cli": "^2.6.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "properties-file": "^5.0.5",
    "protobufjs": "^8.7.1",
    "rotating-file-stream": "^3.2.9"
  }
}